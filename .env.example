# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# Your public domain, e.g. nova-post.duckdns.org (localhost for a local run)
SITE_ADDRESS=localhost

APP_SECRET=
INGEST_SECRET=

# Role passwords are public demo passwords (published in README). Never reuse them elsewhere.
ADMIN_PASSWORD=demo
SENIOR_PASSWORD=demo
OPERATOR_PASSWORD=demo
