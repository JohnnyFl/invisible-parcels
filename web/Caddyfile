# SITE_ADDRESS: your domain (e.g. nova-post.duckdns.org) → Let's Encrypt certificate;
# localhost (default) → Caddy's local certificate
{$SITE_ADDRESS:localhost} {
	# the NP webhook is internal: the emulator calls backend:8080 directly
	handle /api/ingest/* {
		respond 404
	}
	handle /api/* {
		reverse_proxy backend:8080 {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
